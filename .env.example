# Existing browser-safe canonical site URL (not a credential).
NEXT_PUBLIC_SITE_URL=https://wallstreetfatcats.com

# SERVER ONLY. Copy this file to .env.local; never commit real values.
# The production HTTPS URL of the n8n Webhook, NOT the Python endpoint.
GORDON_N8N_WEBHOOK_URL=

# Optional but recommended before public launch. Configure the n8n Webhook with
# Header Auth: header name X-Gordon-Webhook-Key, value matching this secret.
# Omit only when the selected webhook intentionally has no authentication.
GORDON_N8N_WEBHOOK_SECRET=

# Server upstream deadline in milliseconds: integer 1000..105000; default 90000.
# n8n Cloud's own 100-second limit cannot be extended here.
# Website route maxDuration=120 seconds; browser deadline=115 seconds.
GORDON_TIMEOUT_MS=90000
